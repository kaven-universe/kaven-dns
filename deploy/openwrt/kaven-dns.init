#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/kaven-dns

start_service() {
	local enabled data_dir memory_limit max_procs

	config_load 'kaven-dns'
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get data_dir main data_dir '/etc/kaven-dns'
	config_get memory_limit main memory_limit '64MiB'
	config_get max_procs main max_procs '2'

	mkdir -p "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		"KAVEN_DATA_DIR=$data_dir" \
		"GOMEMLIMIT=$memory_limit" \
		"GOMAXPROCS=$max_procs"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile='4096 4096'
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'kaven-dns'
}
